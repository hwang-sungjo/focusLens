{
  "name": "focuslens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "verify:openapi": "cd backend && npm run verify:openapi",
    "verify:ai1": "bash backend/scripts/run-ai1.sh",
    "verify:ai2:absence": "bash backend/scripts/run-ai1.sh --camera",
    "verify:ai2:absence:fixture": "bash backend/scripts/run-ai1.sh --blank-fixture",
    "verify:ai2:focus": "bash backend/scripts/run-ai1.sh --camera-focus",
    "verify:ai2:focus:fixture": "bash backend/scripts/run-ai1.sh --focus-fixture",
    "verify:ai3": "bash backend/scripts/run-ai1.sh --delivery",
    "local:setup": "node backend/scripts/local-env.js",
    "local:up": "node backend/scripts/local-up.js",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f backend migrate",
    "local:seed": "docker compose run --rm --no-deps --entrypoint node migrate /app/prisma/seed.js",
    "local:backup": "node backend/scripts/local-db-backup.js",
    "local:restore": "node backend/scripts/local-db-restore.js",
    "local:recover-auth": "node backend/scripts/recover-local-auth.js",
    "local:ai": "node backend/scripts/local-ai.js",
    "verify:local": "node backend/scripts/verify-local-stack.js",
    "verify:preserve": "node backend/scripts/verify-local-preservation.js",
    "verify:recovery": "node backend/scripts/verify-local-recovery.js",
    "verify:local-ai": "node backend/scripts/verify-local-ai.js",
    "verify:handoff": "node backend/scripts/verify-handoff-stack.js",
    "db:migrate": "cd backend && npx prisma migrate dev --schema=../prisma/schema.prisma",
    "db:migrate:deploy": "cd backend && npx prisma migrate deploy --schema=../prisma/schema.prisma",
    "db:seed": "cd backend && node ../prisma/seed.js",
    "db:reset": "cd backend && npx prisma migrate reset --schema=../prisma/schema.prisma --force",
    "db:views": "docker compose exec -T postgres psql -v ON_ERROR_STOP=1 -U focuslens -d focuslens < prisma/views.sql",
    "rollup": "cd backend && node scripts/rollup.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testMatch": [
      "**/*.test.js"
    ],
    "roots": [
      "<rootDir>/src"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
