# 팀 개발 환경용: 실제 개발 DB/Redis 주소와 비밀값으로 교체
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://focuslens:replace_me@development-db:5432/focuslens?schema=public"

JWT_SECRET=replace_with_a_shared_development_secret
JWT_EXPIRES_IN=1h

REDIS_URL=redis://development-redis:6379
CORS_ORIGIN=https://development.focuslens.example
