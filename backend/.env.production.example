# 프로덕션 키 계약 예시. 실제 값은 저장소의 파일이 아니라 배포 환경의 Secret으로 주입한다.
NODE_ENV=production
PORT=3000

DATABASE_URL="postgresql://focuslens:replace_me@production-db:5432/focuslens?schema=public&sslmode=require"

JWT_SECRET=replace_with_a_long_random_production_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_DOMAIN=focuslens.example

REDIS_URL=rediss://production-redis:6379
CORS_ORIGIN=https://focuslens.example

ROLLUP_ENABLED=true
ROLLUP_SCHEDULE_HOUR_UTC=0
ROLLUP_RAW_RETENTION_DAYS=30
ROLLUP_HOURLY_RETENTION_DAYS=90
ROLLUP_DAILY_RETENTION_DAYS=365
