# 기본 템플릿은 개인 로컬 실행용이다.
# 환경별 예시는 .env.local.example / .env.development.example / .env.production.example 참고.
NODE_ENV=development
PORT=3000

# Database (Prisma)
# 로컬 직접 실행 시: postgresql://focuslens:focuslens_pw@localhost:5432/focuslens?schema=public
# Docker 사용 시:    postgresql://focuslens:focuslens_pw@postgres:5432/focuslens?schema=public
DATABASE_URL="postgresql://focuslens:focuslens_pw@localhost:5432/focuslens?schema=public"

# JWT — access token 만료 1시간 (docs/auth-flow.md 참고)
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=1h

# Redis
# 로컬 직접 실행 시: redis://localhost:6379
# Docker 사용 시:    redis://redis:6379
REDIS_URL=redis://localhost:6379

# CORS — 프론트엔드 개발 서버 주소
CORS_ORIGIN=http://localhost:5173
