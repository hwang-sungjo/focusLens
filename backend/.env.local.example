# 개인 로컬 실행용: backend 프로세스는 호스트에서, DB/Redis는 localhost에서 실행
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://focuslens:focuslens_pw@localhost:5432/focuslens?schema=public"

JWT_SECRET=replace_with_a_local_development_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_SAME_SITE=lax

REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

ROLLUP_ENABLED=false
ROLLUP_SCHEDULE_HOUR_UTC=0
ROLLUP_RAW_RETENTION_DAYS=30
ROLLUP_HOURLY_RETENTION_DAYS=90
ROLLUP_DAILY_RETENTION_DAYS=365
