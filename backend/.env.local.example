# 개인 로컬 실행용: backend 프로세스는 호스트에서, DB/Redis는 localhost에서 실행
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://focuslens:focuslens_pw@localhost:5432/focuslens?schema=public"

JWT_SECRET=replace_with_a_local_development_secret
JWT_EXPIRES_IN=1h

REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
